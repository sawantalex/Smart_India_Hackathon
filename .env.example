# Application Settings
PROJECT_NAME="AI Rural Healthcare System"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL default, SQLite fallback for local testing)
DATABASE_URL="sqlite:///./his.db"
# DATABASE_URL="postgresql://his_user:his_password@localhost:5432/his_db"

# Authentication & Security
# WARNING: Generate strong random secret keys in production using `openssl rand -hex 32`
SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_SECRET_KEY_NEVER_COMMIT"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated list, NO wildcard '*' in authenticated production)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Voice & AI Engine Configurations
STT_PROVIDER="browser_speech" # Options: browser_speech, whisper, mock
TTS_PROVIDER="browser_speech" # Options: browser_speech, gtts, mock
LLM_PROVIDER="mock_safe"      # Options: mock_safe, openai, gemini (Must use Safe Guardrails layer)

# Emergency Verification Settings
EMERGENCY_CONTACT_VERIFIED_DATE="2026-01-01"
DEFAULT_EMERGENCY_HELPLINE="108" # National Ambulance Service (India)
