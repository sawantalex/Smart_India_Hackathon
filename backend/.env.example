# SwasthyaSetu Backend Environment Variables (.env.example)

# General Project Settings
PROJECT_NAME="SwasthyaSetu - Integrated Rural Healthcare System"
ENVIRONMENT="production"
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite default: sqlite:///./his.db
# Production Cloud Database (Neon / Supabase PostgreSQL recommended):
# DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require"
DATABASE_URL="sqlite:///./his.db"

# Security & JWT Authentication
# Generate a secure 64-character hex key in terminal: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="YOUR_PRODUCTION_SECRET_KEY_HERE"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (Comma-separated origins or empty for same-origin rewrites)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Voice & AI Credentials (Optional)
GEMINI_API_KEY=""
STT_PROVIDER="browser_speech"
TTS_PROVIDER="browser_speech"
LLM_PROVIDER="mock_safe"

# Emergency Helpline Settings
EMERGENCY_CONTACT_VERIFIED_DATE="2026-01-01"
DEFAULT_EMERGENCY_HELPLINE="108"
